/* repete (for) e durante (while), inclusive aninhados */
inteira principal() @
[
    inteira i, j, soma, n;
    soma receba 0;
    repete ( i receba 1, i < 11, i receba i + 1 ) edai
    [
        soma receba soma + i;
    ]
    mostrar("soma de 1 a 10 = ", soma);

    n receba 27;
    j receba 0;
    durante ( n > 1 ) edai
    [
        cond ( (n // 2) * 2 == n ) edai [ n receba n // 2; ]
        casocontrario edai [ n receba 3 * n + 1; ]
        j receba j + 1;
    ]
    mostrar("Collatz(27) termina em ", j, " passos");

    repete ( i receba 1, i < 4, i receba i + 1 ) edai
    [
        repete ( j receba 1, j < 4, j receba j + 1 ) edai
        [
            escreve(i * j, " ");
        ]
        novalinha();
    ]
    respost 0;
]
