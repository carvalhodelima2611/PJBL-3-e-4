/* ERRO SEMANTICO esperado com --alvo=uno: as variaveis locais (vetor de 600 inteiras =
 * 2400 bytes) nao cabem na RAM do ATmega328P (2048 bytes, 1600 livres para o programa).
 * No PC este programa e valido. */
inteira principal() @
[
    inteira vet{600} grande;
    grande{0} receba 1;
    respost grande{0};
]
