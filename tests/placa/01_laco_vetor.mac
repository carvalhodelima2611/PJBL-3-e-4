/* Placa: laco + vetor. Ordena um vetor com bubble sort e imprime antes/depois. */
inteira principal() @
[
    inteira i, j, t, n;
    inteira vet{10} v;
    n receba 10;
    repete ( i receba 0, i < n, i receba i + 1 ) edai [ v{i} receba (i * 7 + 3) - (i * 7 + 3) // 10 * 10; ]
    escreve("antes: ");
    repete ( i receba 0, i < n, i receba i + 1 ) edai [ escreve(v{i}, " "); ]
    novalinha();
    repete ( i receba 0, i < n - 1, i receba i + 1 ) edai
    [
        repete ( j receba 0, j < n - 1 - i, j receba j + 1 ) edai
        [
            cond ( v{j} > v{j + 1} ) edai
            [
                t receba v{j};
                v{j} receba v{j + 1};
                v{j + 1} receba t;
            ]
        ]
    ]
    escreve("depois: ");
    repete ( i receba 0, i < n, i receba i + 1 ) edai [ escreve(v{i}, " "); ]
    novalinha();
    respost 0;
]
